// Orientation enum
enum class Orientation { Upright, Reversed };

// TarotCard class with fixed-size strings
class TarotCard {
public:
    const char *name;
    const char *upright;
    const char *reversed;

    TarotCard(const char *n, const char *u, const char *r)
        : name(n), upright(u), reversed(r) {}

    const char* meaning(Orientation o) const {
        return (o == Orientation::Upright) ? upright : reversed;
    }
};

