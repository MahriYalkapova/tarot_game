const int deckSize = sizeof(deck) / sizeof(deck[0]); // entire deck size/size of card

// Fisher–Yates shuffle
void shuffleDeck(TarotCard[],int deckSize_0) {
    for (int i = deckSize_0 - 1; i > 0; --i) {
        int j = rand() % (i + 1);
        TarotCard temp = deck[i];
        deck[i] = deck[j];
        deck[j] = temp;
    }
}

