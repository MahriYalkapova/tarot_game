// Fisher–Yates shuffle
void shuffleDeck(struct TarotCard deck[],int deckSize_0) {
    for (int i = deckSize_0 - 1; i > 0; --i) {
        int j = rand() % (i + 1);
        struct TarotCard temp = deck[i];
        deck[i] = deck[j];
        deck[j] = temp;
    }
}
 
