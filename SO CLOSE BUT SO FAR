void timer2_InIt(void){
SYSCTL_RCGCTIMER_R |= 0x04;  // ENABLE CLOCK FOR  TIMER 2
TIMER2_CTL_R &= ~0x01;         /* disable Timer2A before initialization */
TIMER2_CFG_R = 0x00;         /* 32-bit option */
TIMER2_TAMR_R = 0x02;        /* B: bit [1][0]:00 Reset, 01 for 1 shot mode, 10 for periodic mode, 11 for capture mode; & bit [4]: 0 for down-counter, 1 for up counter */
//  TIMER2_TAILR_R = 100000000= - 1; /* Timer B interval load value register */ // SETS 2 SEC CNTDWN PERIOD Assuming processor frequency 50 MHz default. However, frequency can be max 80 MHz
TIMER2_TAILR_R = 64000000-1; /* Timer A interval load value register Defines Timer Period */ //SYSCLK: 80MHz.-> 64000000/80Mhz =.8s to reload.  
TIMER2_ICR_R = 0x01;          /* clear the Timer2A timeout flag (BIT 1) after each cycle*/
//TIMER2_TAV_R = 0; // RESET COUNTER WE WANT THIS T BEFORE THE SHUFFLE 
TIMER2_CTL_R |= 0x01;        /* enable Timer 2A  after initialization (BIT 1) */
//	TIMER2_TAPR_R = 0; // Prescalar value here is multiplying by 2 (1+1).. Can extend the cycle time max 256 times
}


void PortE_Init(void){ 
SYSCTL_RCGC2_R |= 0x0000010;     // 1) E clock
volatile unsigned long delay;
delay = SYSCTL_RCGC2_R; //reading register adds a delay
GPIO_PORTE_CR_R |= 0x10;           // Allow changes to PE4 ***
GPIO_PORTE_AMSEL_R &= ~0x10; //disable analog functions. 	
GPIO_PORTE_AFSEL_R &= ~0x10; //no alternative functions. 
//GPIO_PORTE_PCTL_R = 0x00000000;   // 4) GPIO clear bit PCTL 
GPIO_PORTE_DIR_R &= ~0x10; //0x1E = 0001 1110 Connected pins are E4; INPUT ***
GPIO_PORTE_PUR_R |= ~0x10;          // enable pullup resistors on PE4 ***
GPIO_PORTE_DEN_R |= 0x10;          // enable digital pins PE4 ***
GPIO_PORTE_IS_R &= ~SOUND_SENSOR; //edge sensitive
GPIO_PORTE_IBE_R &= ~SOUND_SENSOR; //not both edges
GPIO_PORTE_IEV_R &=  ~SOUND_SENSOR; //Falling edge
GPIO_PORTE_ICR_R = SOUND_SENSOR; //clear pending
GPIO_PORTE_IM_R |= SOUND_SENSOR; //arm interrupt
NVIC_EN0_R |= 0x00000010; //EnableInterrupts IRQ4 for PortE
NVIC_PRI1_R = (NVIC_PRI1_R & 0xFF1FFFFF) | 0x00200000;
}

void PortA_Init(void){
SYSCTL_RCGC2_R |= 0x00000001;     // 1) Enable clock for Port A (bit 0)
volatile unsigned long delay = SYSCTL_RCGC2_R;
GPIO_PORTA_CR_R  |= (BTN_1 | BTN_2);   // allow changes on PA2, PA3

GPIO_PORTA_AMSEL_R &= ~(BTN_1 | BTN_2); // disable analog on PA2, PA3
GPIO_PORTA_AFSEL_R &= ~(BTN_1 | BTN_2); // no alternate functions
//GPIO_PORTA_PCTL_R &= ~0x0000FF00;         // clear PCTL for PA2, PA3 (optional)

GPIO_PORTA_DIR_R  &= ~(BTN_1 | BTN_2);  // PA2, PA3 inputs
GPIO_PORTA_PUR_R  |=  (BTN_1 | BTN_2);  // enable pull-ups (active-low buttons)
GPIO_PORTA_DEN_R  |=  (BTN_1 | BTN_2);  // digital enable PA2, PA3
	
GPIO_PORTA_IS_R &= ~(BTN_1 | BTN_2);       /*  PA2&3 edge-sensitive */
GPIO_PORTA_IBE_R &= ~(BTN_1 | BTN_2);      /*  PA2&3 is not both edges */
GPIO_PORTA_IEV_R &= ~(BTN_1 | BTN_2);      /*  PA2&3 falling edge event */
GPIO_PORTA_ICR_R = (BTN_1 | BTN_2);        /*  Clear flag4&5 */
GPIO_PORTA_IM_R |= (BTN_1 | BTN_2);        /*  arm interrupt on PA2 & PA3 */
NVIC_EN0_R |= 0x00000001; 		/*enables interrupt for port A in NVIC*/
NVIC_PRI0_R = (NVIC_PRI0_R & 0xFFFFFF1F) | 0x00000080; /*  priority 4 */	

}



