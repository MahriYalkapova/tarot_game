{
    GPIO_PORTA_ICR_R = (BTN_1 | BTN_2);
		//READ PINS
		SW1 = GPIO_PORTA_DATA_R&BTN_1;  // SW1 TO SCROLL FOR NOW> read PA2 into SW1
		SW2 = GPIO_PORTA_DATA_R&BTN_2;		//Read PA3 into SW2

			if (SW1==0){//BTN_1 Triggered
					selReadingFlag = 1;
			}
			if (SW2 == 0){//BTN_2 Triggered
				shuffleFlag = 1;
			}	
}

void GPIOE_Handler(void){
	if(GPIO_PORTE_RIS_R & 0x10){
		GPIO_PORTE_ICR_R=0x10;
		shuffleFlag = 1;
	}
}
		
		
