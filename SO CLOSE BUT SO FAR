Timer0A_WaitMs(150);
}

if (SW2 == 0){
Timer0A_WaitMs(150);
return typeIndex; //return current choice
}
}
}

//show card & meaning
void showCardOnLCD(struct TarotCard *card, enum Orientation o) {
LCD_Cmd(clear_display);
LCD_Cmd(firstRow);

LCD_string(card->name);

currentMeaning = (o == Upright) ? card -> upright : card -> reversed;
scrollOffset = 0;

LCD_Cmd(secondRow);
for (int i = 0; i < 16; i++) {
char c = currentMeaning[i];
if (c == '\0') c = ' ';
LCD_write_char(c);
}
}

//side-scroll
void scrollMeaningStep(void) {
if (currentMeaning == 0) return;

int len = 0;
while (currentMeaning[len] != '\0') {
len++;
}

if (len <= 16) return;

scrollOffset++;
if (scrollOffset > (len - 16)) {
scrollOffset = 0;
}

LCD_Cmd(secondRow);
for (int i = 0; i < 16; i++) {
int index = scrollOffset + i;
char c = (index < len) ? currentMeaning[index] : ' ';
LCD_write_char(c);
}
}
void squiggle(const char *readingType){
for(int col = 0; col<16; col++){
	LCD_Cmd(0x01); //clear display
	Timer0A_WaitMs(150);
	if (col%2 == 0){
		LCD_Cmd(0x80 + col); //On 1st row
	}else{
		LCD_Cmd(0xC0 + col); //On 2nd Row
	}
	LCD_string("*");
}
// DIVING YOUR [chosen Reading Type]
		LCD_Cmd(0x01);  // clear display
		LCD_Cmd(0x80+1);	// first row , center-ISH
		LCD_string("DIVINING YOUR");
		timer2A_800mSdelay(1);
		char buffer[32];
		sprintf(buffer,"         %s   ", readingType);	
		for (int i = 0; buffer[i]!='\0';i++){
			LCD_Cmd(0xC0);//reset to start of line 2
			LCD_string("                ");   
			LCD_Cmd(0xC0);//back to start of line 2 
			LCD_string(&buffer[i]); //print substring starting at i
			Timer0A_WaitMs(400);;// delay between shifts

		}	Timer0A_WaitMs(400);;// delay between shifts

}

