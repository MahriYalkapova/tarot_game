deck[i] = deck[j];
deck[j] = temp;
}
}

int main() {
Timer0A_Init();
LCD_init();	
timer2_InIt();
PortE_Init();	//CALL INITIALIZATION OF PORTS E1-E4;
PortA_Init();

//*****SPLASH SCREEN*****
LCD_Cmd(0x01);  // clear display
Timer0A_WaitMs(150);
LCD_Cmd(0x80);	// first row
Timer0A_WaitMs(200);
LCD_string("WELCOME TO");
Timer0A_WaitMs(500);
LCD_Cmd(0xC0); //2nd Row
LCD_string("430 Mystic Tarot");
timer2A_800mSdelay(2); 
LCD_Cmd(0x01);  // clear display_left	
Timer0A_WaitMs(150);
LCD_Cmd(0x80);	// first row
Timer0A_WaitMs(150);
type = selReadingType();

//ENABLE INTERRUPTS
EnableInterrupts();             /* Enable global Interrupt flag (I) */	

unsigned long sound = GPIO_PORTE_DATA_R & SOUND_SENSOR;
int lastClap = (sound ? 1 : 0);  // seed with real state

while (1) {
	//block shuffle until selReadingType is done
	if (state == SelectingType){
		type = selReadingType(); //block shuffle until selReadingType is 
		state = ReadyToShuffle; 
	}
	//Define Clap to Shuffle: 
		unsigned long clap = GPIO_PORTE_DATA_R & SOUND_SENSOR;
		int clapNow = (clap ? 1 : 0);
	
	if(state == ReadyToShuffle && (shuffleFlag || (lastClap ==1 && clapNow == 0))){
		shuffleFlag = 0;
		
		squiggle(rType[type]); // DO SOME MAGIC
		timer2A_800mSdelay(2);

		srand(TIMER2_TAV_R);  //PULL FROM CLOCK TO GENERATE RANDOM CARD
		shuffleDeck(deck, deckSize);
		
		struct TarotCard drawn = deck[0];
		enum Orientation o = (rand() % 2 == 0) ? Upright : Reversed;
		
		Timer0A_WaitMs(150);
		
		
		showCardOnLCD(&drawn, o);
		Timer0A_WaitMs(200); //debounce
		timer2A_800mSdelay(4);
		state = ShowingCard;
		
	}
		
	if(selReadingFlag){
		type = selReadingType();
		selReadingFlag = 0;
		state = ReadyToShuffle;
	
	}
//update clap state 
lastClap = clapNow;

//side scroll every 250ms
Timer0A_WaitMs(250);
scrollMeaningStep();
}

}

void timer2A_800mSdelay(int ttime) { //  
// 100 mSEC 
for(int i = 0; i < ttime; i++) { 
TIMER2_CTL_R |=0x01; //Enable the timer
while ((TIMER2_RIS_R & 0x01) == 0);      /* wait for Timer2 timeout flag */
TIMER2_ICR_R = 0x01;      /* clear the Timer2 timeout flag */
}
}

int selReadingType(void){
LCD_Cmd(0x01); // Clear display 
Timer0A_WaitMs(10);
LCD_string("Sel Reading type");
LCD_Cmd(0xC0);
LCD_string(rType[typeIndex]);	// start with Past
while(1){ 
SW1 = GPIO_PORTA_DATA_R&BTN_1;  // SW1 TO SCROLL FOR NOW> read PA2 into SW1
SW2 = GPIO_PORTA_DATA_R&BTN_2;		//Read PA3 into SW2
if (SW1 == 0){// SW1 to SCROLL is pushed
typeIndex = (typeIndex + 1)%3; 
//LCD_Cmd(0x01); // Clear display 
LCD_Cmd(0xC0); //Move cursor to top of 2nd Row 
LCD_string("                "); // 16 SPACES TO CLEAR 2nd LINE
LCD_Cmd(0xC0); //Move cursor to top of 2nd row
