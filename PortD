//timer0A
void Timer0A_Init(void) {
		SYSCTL_RCGCTIMER_R |= 0x01;  // ENABLE CLOCK FOR  TIMER 0
    TIMER0_CTL_R = 0x00;         /* disable Timer0A before initialization */
    TIMER0_CFG_R = 0x00;         /* 32-bit option */
	  TIMER0_TAMR_R = 0x02;        /* B: bit [1][0]:00 Reset, 01 for 1 shot mode, 10 for periodic mode, 11 for capture mode; & bit [4]: 0 for down-counter, 1 for up counter */
	  TIMER0_TAILR_R = 80000-1; 	 // 80 MHz / 80,000 = 1kHz => 1ms
		TIMER0_ICR_R = 0x01;          /* clear the Timer0A timeout flag (BIT 1) after each cycle*/
	  TIMER0_CTL_R |= 0x01;        /* enable Timer 0A  after initialization (BIT 1) */
	//	TIMER2_TAPR_R = 0; // Prescalar value here is multiplying by 2 (1+1).. Can extend the cycle time max 256 times
}

void Timer0A_WaitMs(unsigned long ms) {
		for (unsigned long i = 0; i < ms; i++) {
			while ((TIMER0_RIS_R & 0x01) == 0) {}
			TIMER0_ICR_R = 0x01;
		}
}

//-----------------------------SUBROUTINES TO INITIALIZE timer0A, timer2A, PORTD, PORTE, PORTF, & LCD-----------------------------	
void timer2_InIt(void){
	  SYSCTL_RCGCTIMER_R |= 0x04;  // ENABLE CLOCK FOR  TIMER 2
    TIMER2_CTL_R &= ~0x01;         /* disable Timer2A before initialization */
    TIMER2_CFG_R = 0x00;         /* 32-bit option */
	  TIMER2_TAMR_R = 0x02;        /* B: bit [1][0]:00 Reset, 01 for 1 shot mode, 10 for periodic mode, 11 for capture mode; & bit [4]: 0 for down-counter, 1 for up counter */
  //  TIMER2_TAILR_R = 100000000= - 1; /* Timer B interval load value register */ // SETS 2 SEC CNTDWN PERIOD Assuming processor frequency 50 MHz default. However, frequency can be max 80 MHz
	  TIMER2_TAILR_R = 64000000-1; /* Timer A interval load value register Defines Timer Period */ //SYSCLK: 80MHz.-> 64000000/80Mhz =.8s to reload.  
		TIMER2_ICR_R = 0x01;          /* clear the Timer2A timeout flag (BIT 1) after each cycle*/
    //TIMER2_TAV_R = 0; // RESET COUNTER WE WANT THIS T BEFORE THE SHUFFLE 
	  TIMER2_CTL_R |= 0x01;        /* enable Timer 2A  after initialization (BIT 1) */
	//	TIMER2_TAPR_R = 0; // Prescalar value here is multiplying by 2 (1+1).. Can extend the cycle time max 256 times
}

//INITIALIZE PORT D  !!FINISH AND TEST
void PortD_Init(void){
	volatile unsigned long delay;
  SYSCTL_RCGC2_R |= 0x00000008;     // 1) D clock
  delay = SYSCTL_RCGC2_R;           // reading register adds a delay   
  
  GPIO_PORTD_CR_R = 0x06;           // allow changes to PD2-PD1       
  GPIO_PORTD_AMSEL_R = 0x00;        // 3) disable analog function
//  GPIO_PORTD_PCTL_R = 0x00000000; // 4) GPIO clear bit PCTL  
  GPIO_PORTD_DIR_R = 0x19;          // 5) PD2,PD1 input, PD4,PD3,PD0 output 0b00011001   
  GPIO_PORTD_AFSEL_R = 0x00;        // 6) no alternate function
  GPIO_PORTD_PUR_R = 0x06;          // enable pullup resistors on PD2,PD1       
  GPIO_PORTD_DEN_R = 0x06;          // 7) enable digital pins PD2 & PD1    
  //NVIC_EN0_R = 0x0000008;        /* 8 1000 sets bit 3 to 1 Enables interrupt 3 for PortD in NVIC enabling PD1&PD2 */  
	NVIC_PRI0_R |= (NVIC_PRI0_R & 0x1FFFFFFF) | 0xA000000; /* Clrs bits 31:29 PField for IRQ 3 PortD: A = 1010 makes b31-29:101 = 2^2+2^0 priority 5 */
	} 
//INITIALIZE PORT E 
void PortE_Init(void){ 
	SYSCTL_RCGC2_R |= 0x0000010;     // 1) E clock
	volatile unsigned long delay;
	delay = SYSCTL_RCGC2_R; //reading register adds a delay
  GPIO_PORTE_CR_R = 0x10;           // Allow changes to PE4 ***
  GPIO_PORTE_AMSEL_R = 0x00; //disable analog functions. 	
	GPIO_PORTE_AFSEL_R = 0x00; //no alternative functions. 
	//GPIO_PORTE_PCTL_R = 0x00000000;   // 4) GPIO clear bit PCTL 
	GPIO_PORTE_DIR_R &= ~0x10; //~0x10 : 1110 1111 Connected pins are E4; 0 for INPUT ***
	GPIO_PORTE_PUR_R = 0x00;          // disable all pullup resistors ***
  GPIO_PORTE_DEN_R = 0x10;          // enable digital pins PE1-PE4 ***
	
}

//INITIALIZE PORT F 
void PortF_Init(void){
volatile unsigned long delay;
  SYSCTL_RCGC2_R |= 0x00000020;     // 1) F clock
  delay = SYSCTL_RCGC2_R;           // reading register adds a delay   
  GPIO_PORTF_LOCK_R = 0x4C4F434B;   // 2) unlock PortF PF0  
  GPIO_PORTF_CR_R = 0x11;           // allow changes to PF4-0       
  GPIO_PORTF_AMSEL_R = 0x00;        // 3) disable analog function
//  GPIO_PORTF_PCTL_R = 0x00000000; // 4) GPIO clear bit PCTL  
  GPIO_PORTF_DIR_R = 0x0E;          // 5) PF4,PF0 input, PF3,PF2,PF1 output 0b01110   
  GPIO_PORTF_AFSEL_R = 0x00;        // 6) no alternate function
  GPIO_PORTF_PUR_R = 0x11;          // enable pullup resistors on PF4,PF0       
  GPIO_PORTF_DEN_R = 0x11;          // 7) enable digital pins PF4-PF0    
  NVIC_EN0_R |= 0x40000000;        /* 4 0100 sets bit 30 to 1 Enables interrupt 30 for PortF in NVIC enabling PF0-PF4 */  
	NVIC_PRI7_R = (NVIC_PRI7_R & 0xFF1FFFFF) | 0x00600000; /* Clrs bits 23:21 PField for IRQ 30 PortF 6 = 0110 makes b23-21:011 = 2^1+2^0 priority 3 */
}

void LCD_init(void){
		SYSCTL_RCGC2_R |= 0x02;  //B clock
		GPIO_PORTB_DIR_R = 0xFF; //LCD SWITCHES VSS-E and D4-K***
		GPIO_PORTB_DEN_R = 0xFF;
		
		LCD_Cmd(0x20);  // set 5x7 font
		LCD_Cmd(0x28);	// set 4-bit
		LCD_Cmd(0x06);	// move cursor right
		LCD_Cmd(0x01);	// clear display
		LCD_Cmd(0x0F);	// cursor blink
}

void LCD_Cmd(unsigned char cmd){
		LCD_write_nibble(cmd &0xF0, 0);  // 0=command, RS =0
		LCD_write_nibble(cmd << 4, 0);
		
		// if lowest 4-bit data takes more time
		if(cmd < 4){
				Timer0A_WaitMs(2); //delay
				 
		}
		else{ 
				Timer0A_WaitMs(1); //delay
		}
	}		

void LCD_write_nibble(unsigned char data, unsigned char cmd){
		data = data & 0xF0;	// D4-7 data/command
		cmd = cmd & 0x0F;	// D0-3 control , RS =0 for control, RS =1 for data
		GPIO_PORTB_DATA_R = data | cmd | 0x04;  // send data and command to LCD
		GPIO_PORTB_DATA_R |= data; // Ensuring data
		GPIO_PORTB_DATA_R = 0; // Done writing to LCD
}

void LCD_write_char(unsigned char data){
		LCD_write_nibble(data &0xF0, 0x01);
		LCD_write_nibble(data << 4, 0x01);
		Timer0A_WaitMs(1);
}

void LCD_string(const char *str){
		int i;
		for(i=0; str[i]!=0; i++){
				LCD_write_char(str[i]);
		}
	
}


  
